[Unit]
Description=Health03 loopback desktop-proxy
After=health03-web.service
[Service]
DynamicUser=yes
Environment=HEALTH03_PI_APPLIANCE=1 HEALTH03_UPSTREAM_PORT=8010
LoadCredential=localhost.key:/etc/health03/credentials/localhost.key
LoadCredential=localhost.pem:/etc/health03/credentials/localhost.pem
LoadCredential=desktop-proxy-secret:/etc/health03/credentials/desktop-proxy-secret
ExecStart=/usr/bin/node /opt/health03/current/scripts/local_api_proxy.mjs
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
LimitCORE=0
[Install]
WantedBy=multi-user.target
