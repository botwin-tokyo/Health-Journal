[Unit]
Description=Health03 retention
After=postgresql.service health03-bao-agent.service
StartLimitIntervalSec=120
StartLimitBurst=5
[Service]
User=health03-retention
Group=health03-retention
SupplementaryGroups=health03-data health03-kms
WorkingDirectory=/opt/health03/current/backend
EnvironmentFile=/etc/health03/runtime.env
LoadCredential=django-secret:/etc/health03/credentials/django-secret
LoadCredential=smtp-password:/etc/health03/credentials/smtp-password
LoadCredential=tunnel-origin-secret:/etc/health03/credentials/tunnel-origin-secret
ExecStart=/usr/bin/env HEALTH03_ENV=production PGUSER=health03-retention /opt/health03/current/.venv/bin/python /opt/health03/current/backend/manage.py health03_retention
ReadWritePaths=/var/lib/health03
Type=oneshot
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
LimitCORE=0
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
