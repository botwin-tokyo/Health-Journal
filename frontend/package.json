{
  "name": "health-journal-dashboard",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "vite --mode mock --host 127.0.0.1",
    "dev:mock": "vite --mode mock --host 127.0.0.1",
    "generate:api": "node scripts/generate-api.mjs",
    "check:api": "node scripts/generate-api.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep accessibility",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "predev": "node scripts/pdf-assets.mjs",
    "prebuild": "node scripts/pdf-assets.mjs",
    "dev:api": "vite --host 127.0.0.1",
    "predev:api": "node scripts/pdf-assets.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@hookform/resolvers": "7.0.5",
    "@tanstack/react-query": "^5.107.1",
    "lucide-react": "1.70.0",
    "openapi-fetch": "0.17.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^7.18.5",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.0",
    "msw": "3.0.4",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "^8.3.7",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@10.34.9",
  "overrides": {
    "eslint-plugin-jsx-a11y@6.10.2": {
      "eslint": "$eslint"
    }
  }
}
