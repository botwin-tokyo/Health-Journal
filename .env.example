# Copy to .env at the repository root. The frontend reads Vite settings here.
# For backend commands export the settings you use. Copy the production section
# to /etc/health03/runtime.env for systemd. Keep generated credentials in the
# private files described in docs/operations/pi-production.md. Only uncomment
# settings you want to override. The default development preview is fictional.

# Production Pi

# Backend profile. Use development for local testing or production on a provisioned Pi. Production example: production.
# HEALTH03_ENV=

# Pi appliance setting used by infra/gunicorn/config.py. Production example: 1.
# HEALTH03_PI_APPLIANCE=

# Public DNS hostname you control for mobile ingestion. Production example: phone.example.org.
# HEALTH03_UPLOAD_HOST=

# Exact HTTPS dashboard origin. Production example: https://localhost:5173.
# FRONTEND_ORIGIN=

# Exact HTTPS browser API origin. Production example: https://localhost:8443.
# API_ORIGIN=

# Host component of the browser API origin. Production example: localhost.
# API_HOSTNAME=

# Release gate setting used by backend/config/production.py. Production example: /etc/health03/release.json.
# HEALTH03_RELEASE_GATE=

# Release id setting used by backend/config/production.py.
# HEALTH03_RELEASE_ID=

# Deployed revision setting used by backend/config/settings.py.
# HEALTH03_DEPLOYED_REVISION=

# PostgreSQL database name.
# PGDATABASE=

# Kms ca file setting used by backend/config/production.py. Production example: /etc/health03/bao-server-ca.crt.
# KMS_CA_FILE=

# Registered public mobile OAuth client ID.
# ANDROID_CLIENT_ID=

# Smtp host setting used by backend/config/production.py.
# SMTP_HOST=

# Smtp port setting used by backend/config/production.py. Production example: 587.
# SMTP_PORT=

# Smtp user setting used by backend/config/production.py.
# SMTP_USER=

# Smtp from setting used by backend/config/production.py.
# SMTP_FROM=

# Backups enabled setting used by backend/config/settings.py. Production example: 0.
# HEALTH03_BACKUPS_ENABLED=

# Display, development and optional tools

# Backup staging setting used by backend/operations/backup.py.
# BACKUP_STAGING=

# Backup target config setting used by backend/operations/backup.py.
# BACKUP_TARGET_CONFIG=

# Django secret key setting used by backend/config/settings.py.
# DJANGO_SECRET_KEY=

# Blob root setting used by backend/config/settings.py.
# HEALTH03_BLOB_ROOT=

# Check date setting used by frontend/scripts/sleep-presentation-smoke.mjs.
# HEALTH03_CHECK_DATE=

# Delete fixture setting used by frontend/e2e/dashboard.spec.ts.
# HEALTH03_DELETE_FIXTURE=

# E2e url setting used by frontend/playwright.config.ts.
# HEALTH03_E2E_URL=

# Ledger db setting used by scripts/ledger_receiver.py.
# HEALTH03_LEDGER_DB=

# Local desktop setting used by backend/config/settings.py.
# HEALTH03_LOCAL_DESKTOP=

# Proxy port setting used by scripts/local_api_proxy.mjs.
# HEALTH03_PROXY_PORT=

# Real kms tests setting used by tests/backend/test_records.py.
# HEALTH03_REAL_KMS_TESTS=

# Sample url setting used by frontend/scripts/blood-pressure-smoke.mjs.
# HEALTH03_SAMPLE_URL=

# Shared blobs setting used by backend/config/settings.py.
# HEALTH03_SHARED_BLOBS=

# Source lookup versions setting used by backend/config/settings.py.
# HEALTH03_SOURCE_LOOKUP_VERSIONS=

# Upstream port setting used by scripts/local_api_proxy.mjs.
# HEALTH03_UPSTREAM_PORT=

# IANA timezone for dashboard display and default phone configuration. Defaults to UTC.
# JOURNAL_TIMEZONE=

# Pghost setting used by backend/config/settings.py.
# PGHOST=

# Pgport setting used by backend/config/settings.py.
# PGPORT=

# PostgreSQL peer-authentication role.
# PGUSER=

# Restore directory setting used by backend/operations/restore.py.
# RESTORE_DIRECTORY=

# Restore kms address setting used by backend/operations/restore_keys.py.
# RESTORE_KMS_ADDRESS=

# Restore kms ca file setting used by backend/operations/restore_keys.py.
# RESTORE_KMS_CA_FILE=

# Restore kms client cert setting used by backend/operations/restore_keys.py.
# RESTORE_KMS_CLIENT_CERT=

# Restore kms client key setting used by backend/operations/restore_keys.py.
# RESTORE_KMS_CLIENT_KEY=

# Restore kms initial token file setting used by backend/operations/restore_keys.py.
# RESTORE_KMS_INITIAL_TOKEN_FILE=

# Restore ledger export setting used by backend/operations/restore.py.
# RESTORE_LEDGER_EXPORT=

# Restore ledger head setting used by backend/operations/restore.py.
# RESTORE_LEDGER_HEAD=

# Ssh original command setting used by scripts/ledger_receiver.py.
# SSH_ORIGINAL_COMMAND=

# HTTPS API base URL for the browser dashboard.
# VITE_API_BASE_URL=

# Set to 1 only for the trusted loopback desktop build.
# VITE_LOCAL_DESKTOP=

# Public journal title. Defaults to Health Journal.
# VITE_SITE_NAME=

# Public subtitle for the journal.
# VITE_SITE_TAGLINE=

# Private file identifying backup recovery locations.
# RECOVERY_LOCATIONS_FILE=

# Operator-configured SSH destination for the optional deletion ledger.
# LEDGER_SSH_DESTINATION=

# Path to the private SSH identity for ledger publication.
# LEDGER_SSH_KEY=

# Path to the pinned host keys of the ledger destination.
# LEDGER_KNOWN_HOSTS=

# Isolated restore only. Path to the first private unseal share.
# RESTORE_SHARE_1_FILE=

# Isolated restore only. Path to the second private unseal share.
# RESTORE_SHARE_2_FILE=

# Optional local test database password. Production service roles use peer authentication.
# PGPASSWORD=
